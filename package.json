{
  "name": "shinboku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop-first Pokémon GO companion for managing large collections.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-shinboku \"node tests/rules/rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
